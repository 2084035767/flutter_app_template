# ════════════════════════════════════════════
# 环境变量模板
# ════════════════════════════════════════════
# 将本文件复制为 .env.development 或 .env.production
# 通过 --dart-define=env=xxx 选择加载哪个文件：
#
#   flutter run --dart-define=env=development
#   flutter run --dart-define=env=production
#
# ════════════════════════════════════════════

# ── API ───
# 后端 API 基础地址
# 类型: string
# 默认值: https://api.example.com
# 在 bootstrap.dart 中验证，release 模式下缺失会抛异常
# 被 lib/core/config/network_config.dart 使用
BASE_URL=https://api.example.com
